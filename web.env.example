# Settings for the Node server (dist-node/server.mjs). The host keeps a filled copy outside the checkout and
# starts the server with `node --env-file=<that file> dist-node/server.mjs`. Never commit a filled copy.
# Every setting the server reads is listed here (tests/node-hosting.test.mjs checks it against lib/settings.ts).

# Where the process listens. nginx forwards to it and terminates TLS.
HOST=127.0.0.1
PORT=3100
# public = the website (profile, progress, game briefs, Contribute); admin = the staff desks only.
# Anything else, or unset, and the server refuses to start.
SITE_SURFACE=public
# This site's public URL, e.g. https://playairplanegames.com (read by the server scripts, not the app).
SITE_URL=

# The game backend on this server, reached on loopback. Roles come from its account_roles.
GAME_API_BASE_URL=http://127.0.0.1:3000
ROLES_SOURCE=backend
# Mock roles, local only: verified emails, comma-separated. Ignored while ROLES_SOURCE=backend.
# MOCK_ADMIN_EMAILS=
# MOCK_PHOTOGRAPHER_EMAILS=
# "mock" shows a labelled progress sample in a development build only. Leave unset on a server.
# PROGRESS_SOURCE=

# Firebase web config of the cloud project airplane-games-auth-20261022 (public values, but the real ones).
FIREBASE_PROJECT_ID=airplane-games-auth-20261022
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=airplane-games-auth-20261022.firebaseapp.com
FIREBASE_APP_ID=
# Local Auth emulator only (demo-airplane-games). Never set on a server.
# FIREBASE_AUTH_EMULATOR_HOST=

# Bunny private photo storage. The password is the zone's read-write Storage Zone Password, never the account
# API key. Without PHOTO_STORAGE_PROVIDER=bunny, photo routes answer 503.
# PHOTO_STORAGE_PROVIDER=bunny
# BUNNY_STORAGE_ZONE=aviation-arcade-website
# BUNNY_STORAGE_REGION=de
# BUNNY_STORAGE_ENDPOINT=https://de-s3.storage.bunnycdn.com
# BUNNY_STORAGE_PASSWORD=

# Shared demo account (never admin or photographer). Same uid as the backend's DEMO_ACCOUNT_UID.
# DEMO_ACCOUNT_UID=
# DEMO_LOGIN_EMAIL=
# DEMO_LOGIN_PASSWORD=
